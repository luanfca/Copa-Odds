{
  "name": "copa-odds",
  "version": "1.0.0",
  "description": "Agregador de odds de desarmes da Copa do Mundo",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ws": "npx tsx scripts/start-with-ws.mjs",
    "dev:sofa": "node scripts/start-sofa.mjs",
    "dev:watchdog": "node scripts/watchdog.mjs",
    "build": "next build",
    "start": "next start",
    "scrape": "tsx scripts/run-scrape.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test -- --runInBand",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/setup-prisma.mjs",
    "db:setup": "node scripts/setup-prisma.mjs",
    "db:push:pg": "DATABASE_URL=postgresql://... npx prisma db push",
    "db:migrate": "node scripts/setup-prisma.mjs && npx prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fast-levenshtein": "^3.0.0",
    "lucide-react": "^0.400.0",
    "next": "15.5.21",
    "playwright": "^1.45.0",
    "playwright-extra": "^4.3.6",
    "prisma": "^5.15.0",
    "protobufjs": "^8.7.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.13.0",
    "ws": "^8.21.0"
