    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.6",
    "ts-jest": "^29.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
