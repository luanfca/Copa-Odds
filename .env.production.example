# ============================================
# Odds ao Vivo — Production Environment
# ============================================
# Copy this file to .env and fill in your values.
# For local development, keep DATABASE_URL=file:./dev.db

# ─── Database ──────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Neon, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (Supabase): postgresql://postgres.xxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ─── Next.js ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app
NODE_ENV=production

# ─── WebSocket Server ──────────────────────────────────
# Port for the WebSocket server (separate from Next.js 3000)
WS_PORT=3001

# ─── Scraping Configuration ────────────────────────────
# Set to 'true' to use mock data instead of live scraping
USE_MOCK=false

# Maximum concurrent scrapes per adapter
MAX_CONCURRENT_SCRAPE=3

# Scrape interval in minutes
SCRAPE_INTERVAL_MINUTES=15

# ─── Logging ───────────────────────────────────────────
# Log level: error, warn, info, verbose, debug, silly
LOG_LEVEL=info

# ─── Security ──────────────────────────────────────────
# Secret key for any signed cookies/tokens
SECRET_KEY=your-random-secret-key-at-least-32-chars

# ─── Optional: Monitoring ──────────────────────────────
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# ─── Optional: SofaScore API ───────────────────────────
# SofaScore API key for match statistics (optional)
# SOFASCORE_API_KEY=your-api-key-here
