# Endereço público gratuito criado no DuckDNS, sem https://
DOMAIN=seu-projeto.duckdns.org

# E-mail usado pelo Caddy para emissão e renovação do certificado HTTPS
ACME_EMAIL=seu-email@exemplo.com

# Acesso provisório ao site inteiro
BASIC_AUTH_USER=admin
# Gere com:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext "SUA-SENHA"
BASIC_AUTH_PASSWORD_HASH='$2a$14$SUBSTITUA_PELO_HASH_GERADO'

# Gere valores diferentes com: openssl rand -hex 32
SCRAPE_SECRET=substitua-por-um-segredo-aleatorio
ADMIN_SECRET=substitua-por-outro-segredo-aleatorio

# Proxy de saída opcional. Deixe vazio para acesso direto.
PROXY_URL=

# Coleta automática a cada 4 horas, em milissegundos
CRON_SCHEDULE=14400000
SCRAPE_ON_START=false

# Perfil de coleta
SCRAPE_PROFILE=fast
PLAYWRIGHT_TIMEOUT=45000
SCRAPE_RETRIES=3

# Casas instáveis permanecem desligadas inicialmente
BET365_ENABLED=false
BETSSON_ENABLED=false
BETFAIR_ENABLED=true

# Credenciais opcionais das casas
BETFAIR_USER=
BETFAIR_PASS=
BETMGM_USER=
BETMGM_PASS=
SUPERBET_USER=
SUPERBET_PASS=
PITACO_SESSION_COOKIE=
